{
  "name": "agent-watchdog",
  "version": "0.2.0",
  "private": true,
  "description": "Independent service supervision & monitoring control plane. Registry-driven health probes, state machine, auto-remediation and deploy-safe pause. Runs as its own HTTP service with OS-level autostart (launchd / systemd --user).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "autostart:install": "bash scripts/install-autostart.sh",
    "autostart:remove": "bash scripts/uninstall-autostart.sh",
    "autostart:status": "bash scripts/autostart-status.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
